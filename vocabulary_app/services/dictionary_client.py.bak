"""Dictionary client for fetching word data from dictionaryapi.dev."""

import json
import re
from typing import Optional, List
import requests
from urllib.parse import quote
from ..models.word import Word
from ..storage.json_storage import JSONStorage

class DictionaryClient:
    """Client for interacting with the free dictionary API."""

    BASE_URL = "https://api.dictionaryapi.dev/api/v2/entries/en/"

    def __init__(self, storage: Optional[JSONStorage] = None) -> None:
        self.storage = storage or JSONStorage()

    def get_word(self, query: str) -> Optional[Word]:
        """Fetch a word definition from the API."""
        if not query or not query.strip():
            raise ValueError("Word input cannot be empty")

        cleaned = self._clean_query(query)
        if not cleaned:
            raise ValueError("Word input is invalid after cleaning")

        try:
            resp = requests.get(f"{self.BASE_URL}{quote(cleaned)}", timeout=10)
            resp.raise_for_status()
            data = resp.json()
            if not isinstance(data, list) or not data:
                return None
            return self._parse(data, cleaned)
        except requests.RequestException as exc:
            print(f"Dictionary API request failed: {exc}")
            return None
        except (KeyError, IndexError, json.JSONDecodeError) as exc:
            print(f"Failed to parse dictionary response: {exc}")
            return None

    def _clean_query(self, query: str) -> str:
        """Validate and clean user input using regex."""
        cleaned = re.sub(r"[^a-zA-Z]", "", query.strip())
        return cleaned.lower()

    def _parse(self, data: list, term: str) -> Word:
        """Parse raw JSON response into a Word object."""
        entry = data[0]
        pronunciation = None
        for phon in entry.get("phonetics", []):
            if phon.get("text"):
                pronunciation = phon["text"]
                break

        meanings = entry.get("meanings", [])
        definition = ""
        synonyms: List[str] = []
        antonyms: List[str] = []

        if meanings:
            first_mean = meanings[0]
            defs = first_mean.get("definitions", [])
            if defs:
                definition = defs[0].get("definition", "")
            synonyms.extend(first_mean.get("synonyms", []))
            antonyms.extend(first_mean.get("antonyms", []))
            
            # Gather more synonyms/antonyms if available
            for m in meanings[1:]:
                synonyms.extend(m.get("synonyms", []))
                antonyms.extend(m.get("antonyms", []))

        return Word(
            term=term,
            pronunciation=pronunciation,
            definition=definition,
            synonyms=list(set(synonyms))[:10],
            antonyms=list(set(antonyms))[:10],
            ai_explanation=None,
            memory_trick=None,
        )
